  function setStatus(message,color){
    var el=document.getElementById('tlStatus');
    if(el){el.textContent=message;el.style.color=color||'#64748b';}
  }
  function showContact(message){
    verified=false;
    var desc=document.getElementById('tlDesc'),contact=document.getElementById('tlContact');
    var title=document.getElementById('tlTitle'),button=document.getElementById('tlActivate');
    if(desc)desc.textContent=message||'License verification failed. नीचे दिए गए नंबर पर संपर्क करें।';
    if(contact)contact.style.display='block';
    if(title)title.textContent='License Verification Failed';
    if(button)button.textContent='Try Again';
    setStatus('आपकी वेबसाइट अभी लॉक है। सही License Key डालें।','#b42318');
  }
  function request(action,key){
    return new Promise(function(resolve,reject){
      var cb='tlcb_'+Date.now()+'_'+Math.floor(Math.random()*1e6);
      var script=document.createElement('script'),done=false;
      var timer=setTimeout(function(){finish(new Error('License server timeout. कृपया दोबारा कोशिश करें।'));},20000);
      function finish(error,data){
        if(done)return;done=true;clearTimeout(timer);
        try{delete window[cb];}catch(e){window[cb]=null;}
        script.onerror=null;
        if(script.parentNode)script.parentNode.removeChild(script);
        if(error)reject(error);
        else if(!data||typeof data!=='object')reject(new Error('License server से गलत Response मिला।'));
        else resolve(data);
      }
      window[cb]=function(data){finish(null,data);};
      script.onerror=function(){finish(new Error('License server से कनेक्शन नहीं हो पाया।'));};
      var params=new URLSearchParams({
        action:action,key:key,domain:domain(),
        page:String(location.href).slice(0,1500),
        ua:String(navigator.userAgent||'').slice(0,500),
        lang:navigator.language||'',
        tz:Intl.DateTimeFormat().resolvedOptions().timeZone||'',
        callback:cb,_:String(Date.now())
      });
      script.src=API_URL+'?'+params.toString();
      document.head.appendChild(script);
    });
  }
  function handleResult(response,key){
    if(response&&response.ok===true){
      verified=true;
      try{localStorage.setItem(STORAGE_KEY,key);}catch(e){}
      var gate=document.getElementById('themeLicenseGate');
      if(gate)gate.remove();
      document.documentElement.style.overflow='';
      document.body.style.overflow='';
      return true;
    }
    var message=response&&response.message?String(response.message):'License verification failed.';
    if(message.indexOf('DOMAIN_MISMATCH:')>=0){
      showContact('यह License किसी दूसरे Domain से जुड़ा है। वर्तमान Domain: '+domain()+'. नया License लेने या Domain बदलवाने के लिए संपर्क करें।');
    }else{
      showContact(message);
    }
    return false;
  }
  function activate(){
    if(checking)return;
    var input=document.getElementById('tlKey');
    var key=String(input&&input.value||'').trim().toUpperCase();
    if(!key){setStatus('कृपया License Key डालें।','#b42318');if(input)input.focus();return;}
    checking=true;
    var button=document.getElementById('tlActivate');if(button)button.disabled=true;
    setStatus('License verify हो रहा है...','#175cd3');
    request('activate',key).then(function(r){handleResult(r,key);}).catch(function(e){showContact(e.message);}).then(function(){checking=false;if(button)button.disabled=false;});
  }
  function verifySaved(){
    var key='';
    try{key=localStorage.getItem(STORAGE_KEY)||'';}catch(e){}
    if(!key){setStatus('अपना License Key डालकर वेबसाइट खोलें।');return;}
    checking=true;
    var input=document.getElementById('tlKey');if(input)input.value=key;
    var button=document.getElementById('tlActivate');if(button)button.disabled=true;
    setStatus('Saved License verify हो रहा है...','#175cd3');
    request('verify',key).then(function(r){
      if(!handleResult(r,key)){try{localStorage.removeItem(STORAGE_KEY);}catch(e){}}
    }).catch(function(e){showContact(e.message);}).then(function(){checking=false;if(button)button.disabled=false;});
  }
  function showGate(){
    var gate=document.getElementById('themeLicenseGate');
    if(gate)gate.style.display='flex';
    document.documentElement.style.overflow='hidden';
    document.body.style.overflow='hidden';
    setStatus('अपना License Key डालकर एक बार Activate करें।');
  }
  function checkAlreadyActivated(){
    setStatus('License status जाँचा जा रहा है...','#175cd3');
    request('check','').then(function(response){
      if(response&&response.ok===true){
        verified=true;
        var gate=document.getElementById('themeLicenseGate');
        if(gate)gate.remove();
        document.documentElement.style.overflow='';
        document.body.style.overflow='';
        return;
      }
      showGate();
      var message=response&&response.message?String(response.message):'';
      if(message.indexOf('LICENSE_EXPIRED')>=0 || (response&&response.code==='LICENSE_EXPIRED')){
        showContact(message);
      }
    }).catch(function(error){
      // Fail closed: if the server cannot confirm activation, require a retry/key.
      showGate();
      setStatus(error.message,'#b42318');
    });
  }
  function init(){
    if(initialized||!document.body)return;
    initialized=true;
    document.body.insertAdjacentHTML('beforeend',markup);
    document.getElementById('tlActivate').addEventListener('click',activate);
    document.getElementById('tlKey').addEventListener('keydown',function(e){if(e.key==='Enter')activate();});
    window.ThemeLicense={activate:activate,verify:checkAlreadyActivated,isValid:function(){return verified;}};
    checkAlreadyActivated();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);
  else init();
})();
